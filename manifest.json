{
    "manifest_version": 3,
    "name": "人声筛选工具",
    "version": "1.17.0",
    "description": "HeyGen 人声筛选工具 – 声音库筛选、试听、我的声音管理、找我的视频、社区(Space)声音搜索/切换/删除、下载与分享到期清理、头像生成声音(HeyGen/Gemini/OpenRouter)",
    "permissions": ["downloads", "storage", "alarms", "notifications"],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "https://*.heygen.com/*",
        "https://*.heygen.ai/*",
        "https://api2.heygen.com/*",
        "https://api.github.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://openrouter.ai/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://app.heygen.com/*"
            ],
            "js": [
                "ais-bridge.js"
            ],
            "world": "MAIN",
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://app.heygen.com/*"
            ],
            "js": [
                "proc11ShareVoice.js",
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}
