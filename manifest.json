{
    "manifest_version": 3,
    "name": "人声筛选工具",
    "version": "1.4.0",
    "description": "HeyGen 人声筛选工具 – 声音库筛选、试听、我的声音管理与下载",
    "permissions": ["downloads"],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "https://*.heygen.com/*",
        "https://*.heygen.ai/*",
        "https://api2.heygen.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://app.heygen.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}
